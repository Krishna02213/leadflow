# Database used by the FastAPI service
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# Exposed to the Next.js browser bundle
NEXT_PUBLIC_API_URL=http://localhost:8000

# Seeded demo account (change in production)
SEED_USER_EMAIL=demo@leadflow.dev
SEED_USER_PASSWORD=demo1234

